{
  "name": "survivor-draft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run data && vite",
    "build": "npm run data && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "data": "tsx scripts/build-data.ts",
    "scrape": "tsx scripts/scrape.ts",
    "summarize": "tsx scripts/summarize.ts",
    "photos": "tsx scripts/fetch-photos.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "tsx --test scripts/lib/wikipedia.test.ts src/lib/scoring.test.ts",
    "report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
